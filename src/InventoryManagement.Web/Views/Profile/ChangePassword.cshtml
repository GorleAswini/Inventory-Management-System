@model InventoryManagement.Web.ViewModels.Account.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Change Password</h3>
        <p class="text-muted mb-0">Update account credentials with strict password rules (SRS Section 7.9).</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Profile
    </a>
</div>

<div class="card p-4 bg-white shadow-sm border-0" style="max-width: 550px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="bi bi-exclamation-circle me-1"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="ChangePassword" method="post">
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary"></label>
            <input asp-for="CurrentPassword" class="form-control" type="password" required />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
            <input asp-for="NewPassword" class="form-control" type="password" required />
            <small class="text-muted d-block mt-1">Rule: Minimum 8 characters, at least 1 uppercase, 1 lowercase, 1 number, and 1 special symbol.</small>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                <i class="bi bi-shield-check me-1"></i> Update Password
            </button>
        </div>
    </form>
</div>
