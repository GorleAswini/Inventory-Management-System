@model InventoryManagement.Core.Entities.User
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">User Profile</h3>
        <p class="text-muted mb-0">Manage personal profile details and security settings (SRS Section 7.8).</p>
    </div>
    <a asp-action="ChangePassword" class="btn btn-outline-primary">
        <i class="bi bi-key me-1"></i> Change Password
    </a>
</div>

<div class="card p-4 bg-white shadow-sm border-0" style="max-width: 700px;">
    <div class="d-flex align-items-center gap-3 border-bottom pb-4 mb-4">
        <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
            <i class="bi bi-person-fill fs-2"></i>
        </div>
        <div>
            <h4 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h4>
            <span class="badge bg-primary-subtle text-primary">@(Model.Role?.Name ?? "User")</span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-sm-6">
            <span class="text-muted small d-block">Employee ID</span>
            <strong>@Model.EmployeeId</strong>
        </div>
        <div class="col-sm-6">
            <span class="text-muted small d-block">Username</span>
            <strong>@Model.Username</strong>
        </div>
        <div class="col-sm-6">
            <span class="text-muted small d-block">Email Address</span>
            <span>@Model.Email</span>
        </div>
        <div class="col-sm-6">
            <span class="text-muted small d-block">Department</span>
            <span>@(Model.Department ?? "General")</span>
        </div>
        <div class="col-sm-6">
            <span class="text-muted small d-block">Account Status</span>
            <span class="badge bg-success">Active</span>
        </div>
        <div class="col-sm-6">
            <span class="text-muted small d-block">Account Created</span>
            <span class="small">@Model.CreatedDate.ToLocalTime().ToString("d")</span>
        </div>
    </div>
</div>
