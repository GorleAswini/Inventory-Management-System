@model List<InventoryManagement.Core.Entities.User>
@{
    Layout = "_Layout";
    ViewData["Title"] = "User Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">User Management</h3>
        <p class="text-muted mb-0">Manage system operators, assign operational roles, and toggle access states.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Add New User
    </a>
</div>

<div class="card bg-white shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th>Employee ID</th>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@user.EmployeeId</span></td>
                        <td class="fw-semibold">@user.FirstName @user.LastName</td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@(user.Department ?? "General")</td>
                        <td><span class="badge bg-primary-subtle text-primary">@(user.Role?.Name ?? "User")</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deactivated</span>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-action="ToggleStatus" asp-route-id="@user.Id" class="d-inline">
                                @if (user.IsActive)
                                {
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to deactivate @user.Username? They will be blocked from logging in.');">
                                        <i class="bi bi-person-x me-1"></i> Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-person-check me-1"></i> Activate
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
