@model InventoryManagement.Web.ViewModels.Users.UserFormViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add New User";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Create User Account</h3>
        <p class="text-muted mb-0">Provision credentials and define system permissions for an employee.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Users
    </a>
</div>

<div class="card p-4 bg-white shadow-sm border-0" style="max-width: 800px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="bi bi-exclamation-circle me-1"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Create" method="post">
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
                <label asp-for="EmployeeId" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="EmployeeId" class="form-control" placeholder="EMP-003" required />
                <span asp-validation-for="EmployeeId" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="FirstName" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="FirstName" class="form-control" placeholder="Jane" required />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="LastName" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="LastName" class="form-control" placeholder="Doe" required />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="Username" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Username" class="form-control" placeholder="jdoe" required />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="jane.doe@demo.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                <small class="text-muted">Min 8 chars with uppercase, lowercase, number, and special character.</small>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="RoleId" class="form-label small fw-semibold text-secondary"></label>
                <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select" required></select>
                <span asp-validation-for="RoleId" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <label asp-for="Department" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Department" class="form-control" placeholder="IT, Operations, Finance..." />
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="MobileNumber" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="MobileNumber" class="form-control" placeholder="+1 234 567 890" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                <i class="bi bi-person-check me-1"></i> Create User
            </button>
        </div>
    </form>
</div>
