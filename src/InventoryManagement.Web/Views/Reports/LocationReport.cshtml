@model Dictionary<string, List<InventoryManagement.Core.Entities.Asset>>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Report 4 - Location Report";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Location-Wise Inventory Report</h3>
        <p class="text-muted mb-0">Hardware distribution across physical campus and rooms (SRS Report 4).</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i> Print</button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    @foreach (var group in Model)
    {
        <div class="col-12 col-lg-6">
            <div class="card bg-white shadow-sm border-0 h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-geo-alt me-2 text-warning"></i>@group.Key</h5>
                    <span class="badge bg-warning text-dark">@group.Value.Count Assets</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="small text-muted text-uppercase">
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in group.Value)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-primary border">@a.AssetCode</span></td>
                                    <td>@a.AssetName</td>
                                    <td>@(a.Category?.Name ?? "--")</td>
                                    <td><span class="badge bg-light text-dark border">@a.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
