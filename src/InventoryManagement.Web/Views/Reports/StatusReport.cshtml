@model Dictionary<string, List<InventoryManagement.Core.Entities.Asset>>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Report 2 - Asset Status Report";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Asset Status Report</h3>
        <p class="text-muted mb-0">Assets grouped by operational lifecycle state (SRS Report 2).</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i> Print</button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    @foreach (var group in Model)
    {
        <div class="col-12">
            <div class="card bg-white shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        Status: <span class="badge @(group.Key == "Available" ? "bg-success" : group.Key == "Assigned" ? "bg-primary" : group.Key == "UnderMaintenance" ? "bg-warning text-dark" : "bg-danger")">@group.Key</span>
                    </h5>
                    <span class="badge bg-secondary">@group.Value.Count Assets</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="small text-muted text-uppercase">
                            <tr>
                                <th>Code</th>
                                <th>Asset Name</th>
                                <th>Category</th>
                                <th>Location</th>
                                <th>Assigned To</th>
                                <th>Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in group.Value)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-primary border">@a.AssetCode</span></td>
                                    <td class="fw-semibold">@a.AssetName</td>
                                    <td>@(a.Category?.Name ?? "--")</td>
                                    <td>@(a.Location ?? "--")</td>
                                    <td>@(a.AssignedToUser != null ? $"{a.AssignedToUser.FirstName} {a.AssignedToUser.LastName}" : "--")</td>
                                    <td>@(a.PurchaseCost.HasValue ? $"${a.PurchaseCost:F2}" : "--")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
