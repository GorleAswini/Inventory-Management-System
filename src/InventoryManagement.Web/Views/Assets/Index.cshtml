@model List<InventoryManagement.Core.Entities.Asset>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Asset Register";
    var categories = ViewBag.Categories as List<InventoryManagement.Core.Entities.Category> ?? new();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Asset Register</h3>
        <p class="text-muted mb-0">Maintain, track, and monitor enterprise hardware and equipment.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Asset
        </a>
    </div>
</div>

<!-- Search & Multi-criteria Filtering (SRS Section 7.3 FR-ASSET-006 & 007) -->
<div class="card p-3 mb-4 bg-white border-0 shadow-sm">
    <form method="get" asp-action="Index" class="row g-3">
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted">Search Assets</label>
            <input type="text" name="search" class="form-control form-control-sm" placeholder="Code, Name, Serial, Location..." value="@ViewBag.Search" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted">Filter Category</label>
            <select name="categoryId" class="form-select form-control-sm">
                <option value="">-- All Categories --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted">Filter Status</label>
            <select name="status" class="form-select form-control-sm">
                <option value="">-- All Statuses --</option>
                @foreach (var st in Enum.GetNames<AssetStatus>())
                {
                    <option value="@st" selected="@(ViewBag.Status == st)">@st</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-fill">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- Assets Table (SRS FR-ASSET-002) -->
<div class="card bg-white shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th>Asset Code</th>
                    <th>Asset Name</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Cost</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-primary border fw-semibold">@item.AssetCode</span></td>
                            <td class="fw-semibold text-dark">@item.AssetName</td>
                            <td>@(item.Category?.Name ?? "N/A")</td>
                            <td>@(item.Location ?? "Unassigned")</td>
                            <td>
                                <span class="badge @(item.Status switch {
                                    AssetStatus.Available => "badge-available",
                                    AssetStatus.Assigned => "badge-assigned",
                                    AssetStatus.UnderMaintenance => "badge-maintenance",
                                    AssetStatus.Damaged => "badge-damaged",
                                    AssetStatus.Retired => "badge-retired",
                                    _ => "badge-lost"
                                })">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                @if (item.AssignedToUser != null)
                                {
                                    <span class="small"><i class="bi bi-person me-1"></i>@item.AssignedToUser.FirstName @item.AssignedToUser.LastName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">--</span>
                                }
                            </td>
                            <td class="small">@(item.PurchaseCost.HasValue ? $"${item.PurchaseCost:F2}" : "--")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit Asset">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Delete Asset" onclick="confirmDelete(@item.Id, '@item.AssetCode - @item.AssetName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No assets found matching the specified search or filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal (SRS BR-010 & FR-ASSET-005) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteForm" method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Asset Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Are you sure you want to delete this asset?</p>
                    <p class="fw-semibold text-dark" id="deleteAssetName"></p>
                    <small class="text-muted">This action will be permanently recorded in the audit trail.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteAssetName').innerText = name;
        const form = document.getElementById('deleteForm');
        form.action = '/Assets/Delete/' + id;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
</script>
}
