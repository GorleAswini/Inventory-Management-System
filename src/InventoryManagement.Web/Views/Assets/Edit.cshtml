@model InventoryManagement.Web.ViewModels.Assets.AssetFormViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Asset";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Edit Asset: @Model.AssetCode</h3>
        <p class="text-muted mb-0">Modify inventory asset details and assignment status.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Register
    </a>
</div>

<div class="card p-4 bg-white shadow-sm border-0" style="max-width: 900px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="bi bi-exclamation-circle me-1"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Edit" method="post" asp-route-id="@Model.Id">
        <input type="hidden" asp-for="Id" />

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="AssetCode" class="form-label fw-semibold small text-secondary"></label>
                <input asp-for="AssetCode" class="form-control" required />
                <span asp-validation-for="AssetCode" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="AssetName" class="form-label fw-semibold small text-secondary"></label>
                <input asp-for="AssetName" class="form-control" required />
                <span asp-validation-for="AssetName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold small text-secondary"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select" required></select>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Status" class="form-label fw-semibold small text-secondary"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<InventoryManagement.Core.Enums.AssetStatus>()" class="form-select" required></select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="SerialNumber" class="form-label fw-semibold small text-secondary"></label>
                <input asp-for="SerialNumber" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="PurchaseDate" class="form-label fw-semibold small text-secondary"></label>
                <input asp-for="PurchaseDate" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="PurchaseCost" class="form-label fw-semibold small text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="PurchaseCost" class="form-control" type="number" step="0.01" />
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
                <label asp-for="Location" class="form-label fw-semibold small text-secondary"></label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Department" class="form-label fw-semibold small text-secondary"></label>
                <input asp-for="Department" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="AssignedToUserId" class="form-label fw-semibold small text-secondary"></label>
                <select asp-for="AssignedToUserId" asp-items="Model.UserOptions" class="form-select"></select>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold small text-secondary"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                <i class="bi bi-save me-1"></i> Update Changes
            </button>
        </div>
    </form>
</div>
