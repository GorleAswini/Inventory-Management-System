@model InventoryManagement.Core.Entities.Asset
@{
    Layout = "_Layout";
    ViewData["Title"] = "Asset Details - " + Model.AssetCode;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Asset Details: @Model.AssetCode</h3>
        <p class="text-muted mb-0">Detailed hardware profile and operational lifecycle tracking.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Asset
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Register
        </a>
    </div>
</div>

<div class="row g-4" style="max-width: 1000px;">
    <div class="col-12 col-md-8">
        <div class="card p-4 bg-white shadow-sm border-0 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">General Information</h5>
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Asset Code</span>
                    <strong class="fs-6 text-primary">@Model.AssetCode</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Asset Name</span>
                    <strong class="fs-6">@Model.AssetName</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Category</span>
                    <span>@(Model.Category?.Name ?? "Uncategorized")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Status</span>
                    <span class="badge @(Model.Status switch {
                        AssetStatus.Available => "badge-available",
                        AssetStatus.Assigned => "badge-assigned",
                        AssetStatus.UnderMaintenance => "badge-maintenance",
                        AssetStatus.Damaged => "badge-damaged",
                        AssetStatus.Retired => "badge-retired",
                        _ => "badge-lost"
                    })">@Model.Status</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Serial Number</span>
                    <span>@(Model.SerialNumber ?? "--")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Purchase Cost</span>
                    <span>@(Model.PurchaseCost.HasValue ? $"${Model.PurchaseCost:F2}" : "--")</span>
                </div>
                <div class="col-12">
                    <span class="text-muted small d-block">Description / Specs</span>
                    <p class="mb-0 text-secondary">@(Model.Description ?? "No additional description provided.")</p>
                </div>
            </div>
        </div>

        <div class="card p-4 bg-white shadow-sm border-0">
            <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">Deployment & Assignment</h5>
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Location</span>
                    <span>@(Model.Location ?? "Unassigned Location")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Department</span>
                    <span>@(Model.Department ?? "Unassigned Department")</span>
                </div>
                <div class="col-12">
                    <span class="text-muted small d-block">Currently Assigned User</span>
                    @if (Model.AssignedToUser != null)
                    {
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <i class="bi bi-person-badge fs-4 text-info"></i>
                            <div>
                                <strong class="d-block">@Model.AssignedToUser.FirstName @Model.AssignedToUser.LastName</strong>
                                <small class="text-muted">@Model.AssignedToUser.Email (@Model.AssignedToUser.EmployeeId)</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Currently in stock / not assigned to any user.</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card p-4 bg-white shadow-sm border-0">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Audit Information</h6>
            <div class="mb-3">
                <span class="text-muted small d-block">Created By</span>
                <span class="small fw-semibold">@Model.CreatedBy</span>
            </div>
            <div class="mb-3">
                <span class="text-muted small d-block">Created Date</span>
                <span class="small">@Model.CreatedDate.ToLocalTime().ToString("f")</span>
            </div>
            <div class="mb-3">
                <span class="text-muted small d-block">Last Modified By</span>
                <span class="small">@(Model.UpdatedBy ?? "--")</span>
            </div>
            <div>
                <span class="text-muted small d-block">Last Modified Date</span>
                <span class="small">@(Model.UpdatedDate.HasValue ? Model.UpdatedDate.Value.ToLocalTime().ToString("f") : "--")</span>
            </div>
        </div>
    </div>
</div>
