@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
    <h2 class="fw-bold">403 - Access Denied</h2>
    <p class="text-muted">You do not have the required role or permission to access this module.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
    </a>
</div>
